# Copy this file to .env and set a random secret before sharing access.
# .env is gitignored and must not be committed.

# development or testing
FLASK_CONFIG=development

# Public self-registration is intended for local development. Set false for private deployments.
ENABLE_PUBLIC_REGISTRATION=true

# Set a unique random value. Production requires at least 32 characters.
SECRET_KEY=

# Required with FLASK_CONFIG=production. Development defaults to the file below.
# DATABASE_URL=sqlite:///instance/financial_reports.db

# ISO 4217 code used as the application default.
DEFAULT_CURRENCY=INR

# Optional development server port.
PORT=5000
