# Copy this file to .env and replace the placeholder values.
# .env is gitignored and must not be committed.

# development or testing
FLASK_CONFIG=development

# Required for any shared or deployed environment.
# Development falls back to a local-only key when this is unset.
SECRET_KEY=replace-with-a-long-random-string

# Optional. When unset, development uses instance/financial_reports.db.
# DATABASE_URL=sqlite:///instance/financial_reports.db

# ISO 4217 code used as the application default.
DEFAULT_CURRENCY=INR

# Optional development server port.
PORT=5000
